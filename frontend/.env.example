# Copy to frontend/.env and fill in. Vite inlines VITE_* into the bundle at build
# time, so everything here is public by construction — these are identifiers, not
# credentials. The API is protected by the Cognito authorizer, not by keeping the
# URL secret. Never put an actual secret in a VITE_ variable.
#
# The first three are required: a build without them fails (see vite.config.js).
# Without VITE_API_URL, api.js falls back to mock data — fine for offline UI work,
# catastrophic if it ever reaches production, which is why the build refuses.

# API Gateway base URL, including the stage.
VITE_API_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com/prod

# Cognito user pool the app authenticates against.
VITE_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Hosted UI domain for the Google OAuth redirect flow, and the public
# origin used to build OAuth redirect URLs. Both have working defaults in
# src/awsConfig.js, so local development runs without them.
VITE_COGNITO_DOMAIN=<name>.auth.us-east-1.amazoncognito.com
VITE_CLOUDFRONT_URL=https://<distribution>.cloudfront.net

# Optional. Set to exactly "true" to answer every API call from src/api.mock.js
# instead of the network — useful for UI work with no backend access. Leave unset
# otherwise. It must be opted into by name: it used to be the automatic fallback
# for a missing VITE_API_URL, and a production deploy once shipped that way and
# served fabricated data to real users. The deploy pipeline fails if a build
# carrying mock fixtures ever reaches the live bundle.
# VITE_USE_MOCK=true
